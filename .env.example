# SQLite for now (Postgres later)
DATABASE_URL="file:./dev.db"

# Twilio — TEST credentials only (https://www.twilio.com/docs/iam/test-credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006

# Postmark — use the sandbox server token / POSTMARK_API_TEST
POSTMARK_SERVER_TOKEN=POSTMARK_API_TEST
POSTMARK_FROM_EMAIL=promos@example.com

# Must stay "true" until the owner signs on and real data is imported.
# Test mode: sends to anything other than 555-01xx numbers / @example.com are BLOCKED; with no Twilio/Postmark
# credentials, sends are simulated locally.
MESSAGING_TEST_MODE=true

# Public URL of the app (used in unsubscribe links and to verify Twilio webhook signatures)
APP_URL=http://localhost:3000
# Long random string; signs unsubscribe links
APP_SECRET=
# Bearer token for GET /api/cron/dispatch (sends scheduled promos; call every ~5 min)
CRON_SECRET=
# Postmark webhook URL: {APP_URL}/api/webhooks/postmark?token=<this>
POSTMARK_WEBHOOK_TOKEN=

# Optional: pin "today" for the seed script (ISO date) to get identical data on any day
# SEED_NOW=2026-11-02

# Mock-data guard: while "true", imports reject any phone outside 555-01xx and any email not @example.com.
# Only set to "false" after the owner signs on and we load his real export.
MOCK_DATA_ONLY=true
