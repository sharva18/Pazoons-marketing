# SQLite for now (Postgres later)
DATABASE_URL="file:./dev.db"

# Twilio — TEST credentials only (https://www.twilio.com/docs/iam/test-credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006

# Postmark — use the sandbox server token / POSTMARK_API_TEST
POSTMARK_SERVER_TOKEN=POSTMARK_API_TEST
POSTMARK_FROM_EMAIL=promos@example.com

# Must stay "true" until the owner signs on and real data is imported
MESSAGING_TEST_MODE=true

# Optional: pin "today" for the seed script (ISO date) to get identical data on any day
# SEED_NOW=2026-11-02
